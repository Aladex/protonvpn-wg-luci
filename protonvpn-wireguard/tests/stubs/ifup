#!/bin/sh
# SPDX-License-Identifier: MIT
# Test stub for netifd's `ifup`, which does not exist off-device. The suite
# puts this directory first on PATH, so by default it behaves exactly like the
# missing command it stands in for: it fails, and bring_up() reports the
# interface did not come up — which is what most tests rely on.
#
# A test that has to drive a SUCCESSFUL connect (the apply transition tests in
# test_ipv6.uc) opts in by creating the marker file, and removes it again
# afterwards. Opt-in rather than opt-out so no existing test silently changes
# behaviour by being run next to one that needs a working ifup.
[ -f "${PROTONVPN_STATE_DIR:-/tmp/protonvpn-test-state}/ifup-ok" ] || exit 1
exit 0
