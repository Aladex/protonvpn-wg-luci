#!/bin/sh
# SPDX-License-Identifier: MIT
# Test stub for curl. Every Proton API call ends in a curl process, and the
# offline suite must never let one near the network — a real call would hit
# api.protonvpn.ch from a test. By default the stub fails the way curl does
# when it cannot connect (exit 7, no output), which api_call() reports as
# code 0, the same "network trouble" a dead WAN produces on the device.
#
# A test that needs the API to answer opts in by writing a response file:
#   $PROTONVPN_RUN_DIR/curl-response — first line the HTTP status, the rest
#   the response body. With `-o <file>` (the /vpn/logicals download path)
#   the body goes to that file and only the status to stdout, matching
#   api_call()'s -w contract. Remove the file afterwards, same opt-in
#   convention as the ifup stub.
#
# A test that needs two DIFFERENT answers in one code path (the client-version
# picker fetches versions.yml and then the repository tags) drops files into
#   $PROTONVPN_RUN_DIR/curl-responses/
# named after a distinctive piece of the URL — 'versions.yml', 'tags'. The
# first file whose name occurs in the requested URL wins; a request matching
# none of them fails the way an unreachable host does, which is what lets a
# test fail exactly one of the two sources.
#
# Whatever arrives on --config is copied to $PROTONVPN_RUN_DIR/curl-config
# before anything else, on EVERY call including the ones that fail. That file
# is a line-oriented curl config built by string concatenation in api.uc, so
# it is the one place a test can see what was actually sent — and the one
# place a value carrying a newline or a quote would show up as an extra curl
# option rather than as part of a header.
resp="${PROTONVPN_RUN_DIR:-/tmp}/curl-response"

cfg=''
prev=''
for a in "$@"; do
	[ "$prev" = "--config" ] && cfg="$a"
	prev="$a"
done
# The config arrives on a pipe fd, so this read consumes it exactly as the
# real curl would.
[ -n "$cfg" ] && cat "$cfg" > "${PROTONVPN_RUN_DIR:-/tmp}/curl-config" 2>/dev/null

# The URL is the last argument api_call() pushes onto the curl command line.
url=''
for a in "$@"; do url="$a"; done

dir="${PROTONVPN_RUN_DIR:-/tmp}/curl-responses"
if [ -d "$dir" ]; then
	resp=''
	for f in "$dir"/*; do
		[ -f "$f" ] || continue
		key=${f##*/}
		case "$url" in
			*"$key"*) resp="$f"; break ;;
		esac
	done
fi

[ -n "$resp" ] && [ -f "$resp" ] || exit 7

code=$(sed -n '1p' "$resp")
out=''
wflag=''
prev=''
for a in "$@"; do
	[ "$prev" = "-o" ] && out="$a"
	[ "$a" = "-w" ] && wflag=1
	prev="$a"
done

# Real curl prints the status only when asked for it with -w. api_call()
# always asks; the external-IP probe in rpcd does not, and appending a status
# to ITS output would be this stub inventing bytes the device never sends —
# exactly the kind of divergence that hides a defect instead of catching one.
if [ -z "$wflag" ]; then
	tail -n +2 "$resp"
	exit 0
fi

if [ -n "$out" ]; then
	tail -n +2 "$resp" > "$out"
	printf '%s' "$code"
else
	# No trailing newline after the status: real curl's -w '\n%{http_code}'
	# leaves the code as the last bytes of output, and api_call() splits on
	# the final newline — a trailing one would read an empty status.
	tail -n +2 "$resp"
	printf '%s' "$code"
fi
exit 0
