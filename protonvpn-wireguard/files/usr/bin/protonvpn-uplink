#!/usr/bin/ucode -S
// SPDX-License-Identifier: MIT
// One endpoint-underlay reconcile pass over every instance (see
// protonvpn.rotate uplink_reconcile). Run by the hotplug hook on interface
// events and safe to run by hand; prints what it did per instance.
//
// `--uninstall` instead takes back what the underlay wrote into
// /etc/config/network (protonvpn.underlay uninstall_cleanup) and has netifd
// load the result. Run by the package's prerm on a real removal only. It
// exits non-zero unless netifd accepted the reload — including one an earlier
// run still owed — so the prerm can fail the removal while the modules that
// can retry it are still installed. The reconcile is held off from the first
// moment (rotate.hold_for_uninstall) so that neither a hotplug event nor a
// manual run can write back what this removed; starting the service lifts it.

'use strict';

import { cursor } from 'uci';

const _rotate = require('protonvpn.rotate');

if (length(ARGV) > 0 && ARGV[0] == '--uninstall') {
	const _routing = require('protonvpn.routing');
	_rotate.hold_for_uninstall();
	let ok = require('protonvpn.underlay').uninstall_cleanup(cursor())
		? _routing.settle_network() : _routing.activate_network();
	printf('%J\n', { uninstalled: true, reloaded: ok });
	exit(ok ? 0 : 1);
}

const uplink_reconcile = _rotate.uplink_reconcile;

printf('%J\n', uplink_reconcile(null));
exit(0);
